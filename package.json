    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "typescript": "^5.8.0"
  }
}
